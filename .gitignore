# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Python distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# Jupyter / IPython
.ipynb_checkpoints
*/.ipynb_checkpoints/*

# IDE and Editor files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Large EEG Raw Data, Audio, Binaries (DO NOT COMMIT DATA)
*.edf
*.EDF
*.rec
*.dat
*.mat
*.fif
*.bdf
*.cnt

# Intermediate processed arrays and window caches
data/processed/*
!data/processed/.gitkeep
data/window_indices/*
!data/window_indices/.gitkeep

# Evaluation annotations (Isolated ground-truth during TTA)
# (Keep directory structure, ignore local cached labels if generated)
data/evaluation_annotations/*
!data/evaluation_annotations/.gitkeep

# Manifests (Keep gitkeep)
data/manifests/*
!data/manifests/.gitkeep

# Heavy Model Checkpoints and Weights
*.pt
*.pth
*.ckpt
*.h5
*.onnx
models/source/*
!models/source/.gitkeep
models/adapted/*
!models/adapted/.gitkeep
models/best/*
!models/best/.gitkeep

# Experiment logs and raw prediction arrays
experiments/logs/*
!experiments/logs/.gitkeep
experiments/predictions/*
!experiments/predictions/.gitkeep
experiments/update_logs/*
!experiments/update_logs/.gitkeep
experiments/checkpoints/*
!experiments/checkpoints/.gitkeep

# Temporary / Scratch files
scratch/
tmp/
temp/
*.log
